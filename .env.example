# TravelNext environment.
#
# EVERY setting here is OPTIONAL. With none of them set, the app runs
# anonymously with the full recommendation engine, no account and no API key —
# which is the project's default and its main promise.
#
# Copy to `.env` and export before running if you want Google Sign-In:
#   set -a && source .env && set +a && uvicorn api.main:app

# ---------------------------------------------------------------- sign-in
# Optional. Enables "Continue with Google" so a traveller's trips persist
# between sessions. Google's OAuth endpoints are free; the cost is that you
# need a Google account and a Cloud project.
#
# To obtain these:
#   1. https://console.cloud.google.com/ -> create (or pick) a project
#   2. "APIs & Services" -> "OAuth consent screen" -> External -> fill in the
#      app name and your email. While the app is in "Testing", add your own
#      Google account under "Test users".
#   3. "APIs & Services" -> "Credentials" -> Create credentials
#      -> OAuth client ID -> Web application
#   4. Authorised redirect URI, exactly:
#         http://localhost:8000/auth/callback
#      (match the host and port you actually serve on; add the production URL
#       too when you deploy)
#   5. Copy the client ID and client secret below.
#
# Leave both blank and sign-in stays switched off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, an ephemeral key is generated per process, so sessions do not
# survive a restart. Set it for anything beyond local experimentation.
TRAVELNEXT_SESSION_SECRET=

# Set to 1 when serving over HTTPS so the session cookie is marked Secure.
TRAVELNEXT_HTTPS=

# ----------------------------------------------------------------- other
# TRAVELNEXT_LOG_LEVEL=INFO
# TRAVELNEXT_CONFIG=configs/config.yaml
