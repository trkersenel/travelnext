data/processed/

# Trained artefacts
models/*.joblib

# Generated reports and figures ARE committed: they are the project's
# evidence, they are small, and a reviewer should see them on GitHub without
# having to run a two-hour ingestion first.
!reports/
!reports/*.md
!reports/*.csv
!reports/*.json
!reports/figures/*.png

